# Create React App environment variables (must be prefixed with REACT_APP_)
# If no backend is configured, the app uses localStorage automatically.

# Base URL for API, e.g. https://api.example.com
REACT_APP_API_BASE=

# Alternative key to specify backend URL if API_BASE is not provided
REACT_APP_BACKEND_URL=

# Optional, shown for completeness
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
